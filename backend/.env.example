NODE_ENV=development
PORT=3005

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=septem_montes
SYNCHRONIZE=false

#   openssl rand -base64 48
SESSION_PEPPER=

SESSION_COOKIE_NAME=sm_session
SESSION_SLIDING_WINDOW=30d
SESSION_ABSOLUTE_MAX=90d
SESSION_TOUCH_INTERVAL=1h

# Optional: only needed if the API and frontend are on different hosts.
# SESSION_COOKIE_DOMAIN=
# SESSION_COOKIE_SAMESITE=lax

BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRATION=7d

# front of the API (nginx alone = 1). Leave unset when nothing proxies the API:
# trusting the header without a proxy lets clients forge their own IP.
# TRUST_PROXY=1

# Organization that staff login resolves to. Must match a row in organizations.slug.
DEFAULT_ORG_SLUG=septem_montes
